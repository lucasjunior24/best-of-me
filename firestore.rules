rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // =========================================================================
    // Users collection
    // =========================================================================
    match /users/{userId} {

      // Only the authenticated user or shared users can read/write their own document
      match /topics/{topicId} {
        allow read, write: if request.auth != null && (
          request.auth.uid == userId ||
          request.auth.uid in resource.data.sharedWith
        );
        // Allow creation by owner only
        allow create: if request.auth != null && request.auth.uid == userId;
        // Only owner can delete the topic
        allow delete: if request.auth != null && request.auth.uid == userId;
      }

      match /sessions/{sessionId} {
        // Dono da session pode ler/escrever
        allow read, write: if request.auth != null && request.auth.uid == userId;
        // Permitir leitura para usuários que têm o tema compartilhado (Sprint 26 — cross-user visibility)
        allow read: if request.auth != null && exists(
          /databases/$(database)/documents/users/$(userId)/topics/$(resource.data.topicId)
        ) && request.auth.uid in get(
          /databases/$(database)/documents/users/$(userId)/topics/$(resource.data.topicId)
        ).data.sharedWith;
        // Permitir escrita para usuários compartilhados com permissão edit (Sprint 27)
        allow write: if request.auth != null && exists(
          /databases/$(database)/documents/users/$(userId)/topics/$(resource.data.topicId)
        ) && request.auth.uid in get(
          /databases/$(database)/documents/users/$(userId)/topics/$(resource.data.topicId)
        ).data.sharedWith;
      }

      match /preferences/{prefId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }

      // Reviews & Questionnaires (Sprint 25 + Sprint 27)
      match /reviews/{reviewId} {
        // Dono pode ler/escrever. Convidados via sharedWith podem ler e escrever.
        // Apenas owner pode deletar.
        allow read, write: if request.auth != null && (
          request.auth.uid == userId ||
          request.auth.uid in resource.data.sharedWith
        );
        allow create: if request.auth != null && request.auth.uid == userId;
        allow delete: if request.auth != null && request.auth.uid == userId;
      }

      match /reviewQuestionnaires/{questionnaireId} {
        // Cada usuário tem seus próprios questionários. Apenas o dono pode ler/escrever.
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }

    // =========================================================================
    // Shared Topics collection (top-level)
    // =========================================================================
    match /sharedTopics/{sharedId} {
      // Dono do tópico pode ler/escrever
      // Usuário convidado pode ler (para ver convites) e atualizar status
      allow read: if request.auth != null && (
        request.auth.uid == resource.data.ownerUserId ||
        request.auth.uid == resource.data.sharedWithUserId
      );
      allow create: if request.auth != null
        && request.auth.uid == request.resource.data.ownerUserId;
      allow update: if request.auth != null && (
        request.auth.uid == resource.data.ownerUserId ||
        (request.auth.uid == resource.data.sharedWithUserId
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status']))
      );
      allow delete: if request.auth != null
        && request.auth.uid == resource.data.ownerUserId;
    }

    // =========================================================================
    // Shared Reviews collection (top-level) — Sprint 25
    // =========================================================================
    match /sharedReviews/{sharedId} {
      // Dono da review pode ler/escrever
      // Usuário convidado pode ler (para ver convites) e atualizar status
      allow read: if request.auth != null && (
        request.auth.uid == resource.data.ownerUserId ||
        request.auth.uid == resource.data.sharedWithUserId
      );
      allow create: if request.auth != null
        && request.auth.uid == request.resource.data.ownerUserId;
      allow update: if request.auth != null && (
        request.auth.uid == resource.data.ownerUserId ||
        (request.auth.uid == resource.data.sharedWithUserId
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status']))
      );
      allow delete: if request.auth != null
        && request.auth.uid == resource.data.ownerUserId;
    }

    // Deny everything else by default
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
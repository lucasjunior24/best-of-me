rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // =========================================================================
    // Users collection
    // =========================================================================
    match /users/{userId} {

      // Only the authenticated user can read/write their own document
      match /topics/{topicId} {
        allow read, write: if request.auth != null && (
          request.auth.uid == userId ||
          request.auth.uid in resource.data.sharedWith
        );
      }

      match /sessions/{sessionId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
        // Permitir leitura para usuários que têm o tema compartilhado (via sharedWith no tópico)
        allow read: if request.auth != null && exists(
          /databases/$(database)/documents/users/$(userId)/topics/$(resource.data.topicId)
        ) && request.auth.uid in get(
          /databases/$(database)/documents/users/$(userId)/topics/$(resource.data.topicId)
        ).data.sharedWith;
        // Permitir escrita para usuários compartilhados com permissão edit
        allow write: if request.auth != null && exists(
          /databases/$(database)/documents/users/$(userId)/topics/$(resource.data.topicId)
        ) && request.auth.uid in get(
          /databases/$(database)/documents/users/$(userId)/topics/$(resource.data.topicId)
        ).data.sharedWith;
      }

      match /preferences/{prefId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }

    // =========================================================================
    // Shared Topics collection (top-level)
    // =========================================================================
    match /sharedTopics/{sharedId} {
      // Dono do tópico pode ler/escrever
      // Usuário convidado pode ler (para ver convites) e atualizar status
      allow read: if request.auth != null && (
        request.auth.uid == resource.data.ownerUserId ||
        request.auth.uid == resource.data.sharedWithUserId
      );
      allow create: if request.auth != null
        && request.auth.uid == request.resource.data.ownerUserId;
      allow update: if request.auth != null && (
        request.auth.uid == resource.data.ownerUserId ||
        (request.auth.uid == resource.data.sharedWithUserId
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status']))
      );
      allow delete: if request.auth != null
        && request.auth.uid == resource.data.ownerUserId;
    }

    // Deny everything else by default
    match /{document=**} {
      allow read, write: if false;
    }
  }
}